{
  "name": "my-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personality-first desktop AI companion — character, memory, and a living world",
  "license": "MIT",
  "author": "Joshuayang228",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "package": "vite build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "eval:run": "vitest run --config vitest.eval.config.ts",
    "eval:persona": "vitest run --config vitest.eval-persona.config.ts",
    "pretest": "install-electron",
    "test": "vitest run",
    "test:e2e": "npx playwright test --project=ui",
    "test:e2e:electron": "npm run build && npx playwright test --config=playwright.electron.config.ts",
    "test:all": "npm test && npx playwright test --project=ui",
    "bench:database": "node scripts/database-benchmark.mjs",
    "dev:ui-e2e": "vite --mode ui-e2e --host 127.0.0.1 --strictPort --port 5174",
    "eval:skill": "vitest run --config vitest.skill-eval.config.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:impact": "node scripts/docs-impact-check.mjs",
    "docs:validate": "npm run docs:check && npm run docs:impact",
    "arch:check": "vitest run __tests__/unit/architecture-boundaries.test.ts __tests__/unit/companion-surface-registry.test.ts",
    "assets:check": "node scripts/asset-registry-check.mjs && vitest run __tests__/unit/registered-model-request.test.ts __tests__/unit/prompt-assets.test.ts __tests__/unit/prompt-call-coverage.test.ts __tests__/unit/prompt-registration-coverage.test.ts __tests__/unit/prompt-dependencies.test.ts __tests__/unit/model-context-assets.test.ts __tests__/unit/icon-registry.test.ts __tests__/unit/ui-component-registry.test.ts __tests__/unit/design-asset-registry.test.ts __tests__/unit/subagent-asset-registry.test.ts __tests__/unit/product-experience-registry.test.ts __tests__/unit/foundation-enforcement-gate.test.ts",
    "prepare": "node scripts/install-git-hooks.mjs",
    "docs:self-review": "node scripts/docs-self-review.mjs",
    "docs:self-review:prompt": "node scripts/docs-review-prompt.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "sql.js": "^1.14.1",
    "unpdf": "^1.9.1",
    "vectra": "^0.15.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.12"
  }
}
