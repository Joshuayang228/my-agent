{
  "name": "my-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personality-first desktop AI companion — character, memory, and a living world",
  "license": "MIT",
  "author": "Joshuayang228",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "package": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "eval:run": "vitest run --config vitest.eval.config.ts",
    "eval:persona": "vitest run --config vitest.eval-persona.config.ts",
    "test": "vitest run",
    "test:e2e": "npx playwright test --project=ui",
    "test:e2e:electron": "npm run build && npx playwright test --config=playwright.electron.config.ts",
    "test:all": "vitest run && npx playwright test --project=ui",
    "dev:ui-e2e": "vite --mode ui-e2e --host 127.0.0.1 --strictPort --port 5174",
    "eval:skill": "vitest run --config vitest.skill-eval.config.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:impact": "node scripts/docs-impact-check.mjs",
    "docs:validate": "npm run docs:check && npm run docs:impact",
    "prepare": "node scripts/install-git-hooks.mjs",
    "docs:self-review": "node scripts/docs-self-review.mjs",
    "docs:self-review:prompt": "node scripts/docs-review-prompt.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "vectra": "^0.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
